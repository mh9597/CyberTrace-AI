# CyberTrace AI Environment Configuration
# All demo data is strictly synthetic

PROJECT_NAME="CyberTrace AI"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="cybertrace-super-secure-dev-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL with SQLite fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybertrace_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybertrace_ai
SQLITE_FALLBACK_URL=sqlite:///./cybertrace_ai.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# OpenRouter / OpenAI LLM Copilot Configuration
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_FALLBACK_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# SMTP Email Verification (Google Sign-In OTP)
SMTP_ENABLED=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
